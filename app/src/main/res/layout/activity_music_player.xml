<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/music_player_background"
    android:padding="24dp"
    tools:context=".ui.player.MusicPlayerActivity">

    <!-- Top Navigation Bar -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back_to_parent_folder"
        android:src="@drawable/baseline_arrow_back_24"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/playerTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOW PLAYING"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="#88FFFFFF"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        app:layout_constraintBottom_toBottomOf="@+id/backButton"
        app:layout_constraintEnd_toStartOf="@+id/closeButton"
        app:layout_constraintStart_toEndOf="@+id/backButton"
        app:layout_constraintTop_toTopOf="@+id/backButton" />

    <ImageButton
        android:id="@+id/closeButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Stop and Close"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FF5252" />

    <!-- Center Album Art (Vinyl Style Card) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/albumArtCard"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="130dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1AFFFFFF"
        app:strokeWidth="1dp"
        app:strokeColor="#22FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backButton">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Outer Vinyl Grooves Mockup -->
            <ImageView
                android:id="@+id/albumArtImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="48dp"
                android:src="@drawable/baseline_music_note_24"
                app:tint="#8DCDFF"
                android:contentDescription="Album Art" />

            <!-- Vinyl Center Hole/Label -->
            <View
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="@drawable/dialog_rounded_bg"
                android:backgroundTint="#0B1014" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Track Information -->
    <TextView
        android:id="@+id/musicFileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:ellipsize="marquee"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/albumArtCard"
        tools:text="Song Title - Artist" />

    <TextView
        android:id="@+id/musicSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Local Audio"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="#88FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/musicFileName" />

    <!-- SeekBar / Playback Progress -->
    <SeekBar
        android:id="@+id/musicSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:progressTint="#8DCDFF"
        android:thumbTint="#FFFFFF"
        android:progressBackgroundTint="#33FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/musicSubtitle" />

    <!-- Duration Labels -->
    <TextView
        android:id="@+id/musicCurrentPosition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="#B0BEC5"
        app:layout_constraintStart_toStartOf="@+id/musicSeekBar"
        app:layout_constraintTop_toBottomOf="@+id/musicSeekBar"
        tools:text="00:00" />

    <TextView
        android:id="@+id/musicDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="#B0BEC5"
        app:layout_constraintEnd_toEndOf="@+id/musicSeekBar"
        app:layout_constraintTop_toBottomOf="@+id/musicSeekBar"
        tools:text="00:00" />

    <!-- Playback Control Deck -->
    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/musicCurrentPosition">

        <!-- Loop Control -->
        <ImageButton
            android:id="@+id/loopButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/toggle_playing_in_loop"
            android:src="@drawable/baseline_loop_24"
            android:padding="12dp"
            app:tint="#B0BEC5" />

        <!-- Skip Previous -->
        <ImageButton
            android:id="@+id/previousButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous"
            android:src="@drawable/ic_skip_previous_24"
            android:padding="14dp"
            app:tint="#FFFFFF" />

        <!-- Play/Pause FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/playPauseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/play_or_pause"
            android:src="@drawable/ic_play_arrow_24"
            app:backgroundTint="#8DCDFF"
            app:tint="#00344C"
            app:elevation="4dp"
            app:fabCustomSize="72dp"
            app:maxImageSize="36dp" />

        <!-- Skip Next -->
        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next"
            android:src="@drawable/ic_skip_next_24"
            android:padding="14dp"
            app:tint="#FFFFFF" />

        <!-- Extra placeholder/menu button to balance the loop button -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
